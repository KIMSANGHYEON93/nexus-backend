# nexus-backend/.env.example
# 이 파일은 git에 추적됩니다. 실제 값은 .env에만 작성하세요.

# ── 앱 ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── 인프라 ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0

# ── KIS (한국투자증권) ───────────────────────────────────────────────
# 발급처: https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
# paper = 모의투자, live = 실거래 (기본값: paper)
KIS_ENV=paper
# 구독 종목 (기본: 12개 KRX 대형주)
KIS_SUBSCRIBE_SYMBOLS=005930,000660,035420,035720,105560,055550,086790,005380,005490,051910,207940,068270
